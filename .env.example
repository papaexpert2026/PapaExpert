# === Base de datos ===
DATABASE_URL=postgresql+psycopg://papaexpert_user:papaexpert_pass@localhost:5432/papaexpert

# === OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL=

# === YOLO ===
YOLO_MODEL_PATH=models/best.pt
YOLO_CONFIDENCE=0.5

# === CORS ===
# Lista separada por comas de orígenes permitidos
CORS_ORIGINS=http://localhost,http://10.0.2.2,http://127.0.0.1

# === Autenticación ===
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === Uploads ===
MAX_UPLOAD_SIZE_MB=8
UPLOAD_DIR=uploads

# === App ===
APP_ENV=development
